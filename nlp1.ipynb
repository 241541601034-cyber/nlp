   "source": [
    "import nltk\n",
    "from nltk.tokenize import word_tokenize\n",
    "nltk.download('punkt_tab')\n",
    "sentence=input(\"sentence\")\n",
    "words=word_tokenize(sentence)\n",
    "print(words)\n",
    "word=len(words)\n",
    "print(\"words count\",word)\n"
   ]
